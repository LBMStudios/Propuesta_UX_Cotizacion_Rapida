            "mimeType": "text/css",
            "text": ".daterangepicker {\r\n\tborder-radius: 14px;\r\n\tfont-family: \"Poppins\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", \"Noto Sans\", \"Liberation Sans\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\";\r\n}\r\n\r\n.daterangepicker td.in-range {\r\n\tbackground-color: lightcyan;\r\n\tcolor: #005191;\r\n}\r\n\r\n.daterangepicker td.start-date, .daterangepicker td.end-date {\r\n\tbackground-color: #00C4DF;\r\n\tcolor: white;\r\n}\r\n\r\n.daterangepicker td.start-date:hover, .daterangepicker td.end-date:hover {\r\n\tbackground-color: #00C4DF;\r\n}\r\n\r\n.daterangepicker td.start-date {\r\n\tborder-top-left-radius: 20px;\r\n\tborder-bottom-left-radius: 20px;\r\n}\r\n\r\n.daterangepicker td.end-date {\r\n\tborder-top-right-radius: 20px;\r\n\tborder-bottom-right-radius: 20px;\r\n}\r\n\r\n.daterangepicker td.start-date.end-date {\r\n\tborder-radius: 20px;\r\n}\r\n\r\n.daterangepicker .drp-selected {\r\n\tposition: absolute;\r\n\tleft: 10px;\r\n\tbottom: 15px;\r\n\tfont-weight: 600;\r\n}\r\n\r\n.daterangepicker td.disabled {\r\n\tcolor: #e6e6e6;\r\n}\r\n\r\n#custom-drp-selected {\r\n\tdisplay: block;\r\n\ttext-align: center;\r\n\tline-height: 12px;\r\n\tfont-weight: 500;\r\n\tcolor: #005191;\r\n}\r\n\r\n.daterangepicker .drp-buttons {\r\n\tmargin-top: 5px;\r\n}\r\n\r\n.daterangepicker td.weekend {\r\n\tfont-weight: bold;\r\n}\r\n\r\n.daterangepicker td.ends {\r\n\tcolor: white;\r\n}\r\n\r\n.daterangepicker thead tr:first-child th {\r\n\tfont-size: 17px;\r\n\tfont-weight: 500 !important;\r\n}\r\n\r\n.daterangepicker thead tr:last-child th {\r\n\tcolor: gray;\r\n\tfont-weight: 500 !important;\r\n}\r\n\r\n.daterangepicker td, .daterangepicker th {\r\n\tpadding-top: 2px;\r\n\tpadding-bottom: 2px;\r\n}\r\n\r\nbutton.cancelBtn {\r\n\tcolor: #005191 !important;\r\n\ttext-decoration: underline;\r\n}\r\n\r\nbutton.cancelBtn, button.applyBtn {\r\n\tfont-size: 16px !important;\r\n}\r\n\r\n.daterangepicker .calendar-table td, .daterangepicker .calendar-table th {\r\n\twidth: 32px;\r\n\theight: 32px;\r\n\tline-height: 32px;\r\n}\r\n\r\n.daterangepicker .drp-calendar {\r\n\tmax-width: 326px;\r\n}\r\n\r\n.daterangepicker .ltr .show-calendar .opensright {\r\n\tleft: 28px;\r\n}\r\n\r\n@media (max-width: 991.98px) {\r\n\t.daterangepicker .drp-calendar.right {\r\n\t\tdisplay: none !important;\r\n\t}\r\n\r\n\t.daterangepicker {\r\n\t\tposition: fixed !important;\r\n\t\ttop: 50% !important;\r\n\t\tleft: 50% !important;\r\n\t\ttransform: translate(-50%, -50%) !important;\r\n\t}\r\n\r\n\t.daterangepicker:before,\r\n\t.daterangepicker:after {\r\n\t\tdisplay: none !important;\r\n\t}\r\n\r\n\t.daterangepicker .drp-buttons {\r\n\t\tpadding: 15px !important;\r\n\t\tdisplay: flex;\r\n\t\tflex-wrap: wrap;\r\n\t\tgap: 10px;\r\n\t\tjustify-content: center;\r\n\t}\r\n\r\n\t.daterangepicker .drp-buttons .drp-selected {\r\n\t\tposition: static !important;\r\n\t\twidth: 100%;\r\n\t\ttext-align: center;\r\n\t\tmargin-bottom: 5px;\r\n\t}\r\n\r\n\t#custom-drp-selected {\r\n\t\tline-height: 1.8 !important;\r\n\t}\r\n\r\n\t#custom-drp-selected br {\r\n\t\tdisplay: block !important;\r\n\t}\r\n}"
          },
