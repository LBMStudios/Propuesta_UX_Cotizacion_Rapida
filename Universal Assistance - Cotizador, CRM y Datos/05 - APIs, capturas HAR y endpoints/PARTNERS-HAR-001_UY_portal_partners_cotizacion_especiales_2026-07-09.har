          "content": {
            "size": 19468,
            "mimeType": "application/javascript",
            "text": "/* Clases */\r\nclass ItemGA4 {\r\n    constructor(producto, index = 0, esPrecompra) {\r\n        if (!producto) return;\r\n\r\n        producto.PropuestaEmision = producto.PropuestaEmision || {};\r\n        producto.PropuestaEmision.Origen = producto.PropuestaEmision.Origen || {};\r\n        producto.PropuestaEmision.Agencia = producto.PropuestaEmision.Agencia || {};\r\n        producto.PropuestaEmision.TipoViaje = producto.PropuestaEmision.TipoViaje || {};\r\n\r\n        const propuesta = producto.PropuestaEmision;\r\n        const origen = propuesta.Origen;\r\n\r\n        const toUpperSafe = v =>\r\n            typeof v === \"string\" && v.trim() ? v.trim().toUpperCase() : null;\r\n\r\n        const tipoViaje = toUpperSafe(propuesta.TipoViaje.Nombre || producto.TipoViaje);\r\n        const pais = toUpperSafe(origen.CodigoUA || producto.Pais);\r\n        const lista = producto.EsAnual ? \"PLANES ANUALES\" : \"PLANES POR DIAS\";\r\n\r\n        let marca = toUpperSafe(propuesta.Marca || producto.Marca);\r\n        if (marca === \"UA\") marca = \"UNIVERSAL ASSISTANCE\";\r\n\r\n        const brand = [marca, pais].filter(Boolean).join(\" \");\r\n        const tipoProducto = toUpperSafe(propuesta.TipoProducto || producto.TipoProducto);\r\n        const nombreAgencia = toUpperSafe(propuesta.Agencia.Nombre || producto.NombreAgencia);\r\n        const variantRaw = esPrecompra ? producto.PreCompraNombre : producto.NombreProducto;\r\n        let price;\r\n\r\n        if (producto.ImporteUSD == null) { \r\n            price = producto.PrecioEmision;\r\n        } else if (producto.ImporteUSD === 0) {\r\n            price = producto.PrecioEmision; \r\n        } else {\r\n            price = producto.ImporteUSD;\r\n        }\r\n\r\n        this.item_id = toUpperSafe(producto.NombreProducto);\r\n        this.item_name = nombreAgencia;\r\n        this.price = price\r\n        this.item_brand = brand;\r\n        this.item_category = pais;\r\n        this.item_category_2 = tipoProducto;\r\n        this.item_category_3 = tipoViaje;\r\n        this.item_category_4 = null;\r\n        this.item_variant = toUpperSafe(variantRaw);\r\n        this.quantity = 1;\r\n        this.item_list_id = lista;\r\n        this.item_list_name = lista;\r\n        this.index = index;\r\n    }\r\n\r\n    toGA4() {\r\n        return {\r\n            item_id: this.item_id,\r\n            item_name: this.item_name,\r\n            price: this.price,\r\n            item_brand: this.item_brand,\r\n            item_category: this.item_category,\r\n            item_category_2: this.item_category_2,\r\n            item_category_3: this.item_category_3,\r\n            item_category_4: this.item_category_4,\r\n            item_variant: this.item_variant,\r\n            quantity: this.quantity,\r\n            item_list_id: this.item_list_id,\r\n            item_list_name: this.item_list_name,\r\n            index: this.index\r\n        };\r\n    }\r\n}\r\n\r\nclass UpgradeItemGA4 {\r\n    constructor(upgrade, productoSeleccionado, detallePrecio, index = 0) {\r\n        if (!upgrade || !productoSeleccionado) return;\r\n\r\n        productoSeleccionado.PropuestaEmision = productoSeleccionado.PropuestaEmision || {};\r\n        productoSeleccionado.PropuestaEmision.Origen = productoSeleccionado.PropuestaEmision.Origen || {};\r\n        productoSeleccionado.PropuestaEmision.Agencia = productoSeleccionado.PropuestaEmision.Agencia || {};\r\n\r\n        const propuesta = productoSeleccionado.PropuestaEmision;\r\n        const origen = propuesta.Origen;\r\n\r\n        const toUpperSafe = v =>\r\n            typeof v === \"string\" && v.trim() ? v.trim().toUpperCase() : null;\r\n\r\n        let marca = toUpperSafe(propuesta.Marca || productoSeleccionado.Marca);\r\n        if (marca === \"UA\") marca = \"UNIVERSAL ASSISTANCE\";\r\n\r\n        const pais = toUpperSafe(origen.CodigoUA || productoSeleccionado.Pais);\r\n        const brand = [marca, pais].filter(Boolean).join(\" \");\r\n        const lista = \"PLANES ADICIONALES\";\r\n        const cantidad = (detallePrecio && detallePrecio.cantidad) || 1;\r\n        const precioLista = detallePrecio?.precioLista || upgrade.PrecioLista || null;\r\n        const price = upgrade.ImporteUSD > 0 ? upgrade.ImporteUSD : precioLista;\r\n\r\n        const nombreAgencia = toUpperSafe(\r\n            propuesta.Agencia.Nombre || productoSeleccionado.NombreAgencia\r\n        );\r\n\r\n        this.item_id = upgrade.ProductoAdicional;\r\n        this.item_name = nombreAgencia;\r\n        this.price = price;\r\n        this.item_brand = brand || null;\r\n        this.item_category = pais;\r\n        this.item_category_2 = toUpperSafe(upgrade.Relacion);\r\n        this.item_category_3 = toUpperSafe(upgrade.CategoriaProducto);\r\n        this.item_category_4 = null;\r\n        this.item_variant = upgrade.ProductoAdicional;\r\n        this.quantity = cantidad;\r\n        this.item_list_id = lista;\r\n        this.item_list_name = lista;\r\n        this.index = index;\r\n    }\r\n\r\n    toGA4() {\r\n        return {\r\n            item_id: this.item_id,\r\n            item_name: this.item_name,\r\n            price: this.price,\r\n            item_brand: this.item_brand,\r\n            item_category: this.item_category,\r\n            item_category_2: this.item_category_2,\r\n            item_category_3: this.item_category_3,\r\n            item_category_4: this.item_category_4,\r\n            item_variant: this.item_variant,\r\n            quantity: this.quantity,\r\n            item_list_id: this.item_list_id,\r\n            item_list_name: this.item_list_name,\r\n            index: this.index\r\n        };\r\n    }\r\n}\r\n\r\n\r\n/* Fin clases */\r\n\r\n/* Funciones Analytics con DataLayer */\r\n\r\nfunction obtenerPrecioUpgrade(upg, upgId) {\r\n\r\n    let precioBaseLista = upg.PrecioListaProductoAdicional;\r\n\r\n    let divisor = 1; \r\n    let coeficiente = 1; \r\n\r\n    if (upg.Tope) {\r\n        let limite = getSelectedUpgradeLimitId(upgId);\r\n        if (limite) { //para el view_item\r\n            coeficiente = limite.Coeficiente ?? 1;\r\n        }\r\n    }\r\n\r\n    let totalPaxes = $(`[id^=chkPax-${upgId}]`).toArray();\r\n    let totalPaxesNotDisabled = totalPaxes.filter(el => $(el).is(\":not(:disabled)\")).length\r\n\r\n    if (upg.TipodeCobertura === \"Individual\" && !upg.PrecioxPax) {\r\n        divisor = totalPaxesNotDisabled;\r\n    }\r\n\r\n    if (upg.TipodeCobertura === \"Grupal\") {\r\n        divisor = totalPaxesNotDisabled;\r\n    }\r\n\r\n    let precioLista = (precioBaseLista * coeficiente) / divisor;\r\n    return precioLista;\r\n}\r\n\r\nfunction viewItemAnalytics(items) {\r\n    items.forEach((item) => {\r\n        pushEcommerceEvent(\"view_item\", { items: [item] });\r\n    });\r\n}\r\n\r\nfunction addBaseProductToCartAnalytics(item) {\r\n    pushEcommerceEvent(\"add_to_cart\", {\r\n        value: item.price,\r\n        currency: \"USD\",\r\n        items: [item]\r\n    });\r\n}\r\n\r\nfunction viewItemUpgradesAnalytics(items) {\r\n    items.forEach((item) => {\r\n        let value = sumItemsValue([item]);\r\n        pushEcommerceEvent(\"view_item\", {\r\n            value: value,\r\n            currency: \"USD\",\r\n            items: [item]\r\n        });\r\n    })\r\n}\r\n\r\nfunction addToCartUpgradesAnalytics(items) {\r\n    let value = sumItemsValue(items);\r\n    pushEcommerceEvent(\"add_to_cart\", {\r\n        value: value,\r\n        currency: \"USD\",\r\n        items: items\r\n    })\r\n}\r\n\r\nfunction beginCheckoutAnalytics(items, coupon) {\r\n    let value = sumItemsValue(items);\r\n\r\n    let ga4 = {\r\n        value: value,\r\n        currency: \"USD\",\r\n        items: items\r\n    };\r\n\r\n    if (coupon) {\r\n        ga4.coupon = coupon; \r\n    }\r\n\r\n    pushEcommerceEvent(\"begin_checkout\", ga4)\r\n}\r\n\r\nfunction addPaymentInfoAnalytics(items, paymentType, coupon, payerType, operationId, paymentFlow) {\r\n\r\n    let value = sumItemsValue(items);\r\n\r\n    let ga4 = {\r\n        value: value,\r\n        currency: \"USD\",\r\n        items: items\r\n    };\r\n    if (coupon) ga4.coupon = coupon;\r\n\r\n    let payment = {}\r\n    if (paymentType) payment.payment_type = paymentType;\r\n    if (payerType) payment.payer_type = payerType;\r\n    if (operationId) payment.operation_id = operationId;\r\n    if (paymentFlow) payment.payment_flow = paymentFlow;\r\n\r\n    pushEcommerceEvent(\"add_payment_info\", ga4, payment)\r\n}\r\n\r\nfunction purchaseAnalytics(items, tax, transactionId, operationId, coupon,\r\n    payerType, paymentFlow, paymentType, shipping, payment_status) {\r\n    let value = sumItemsValue(items);\r\n    let ga4 = {\r\n        transaction_id: transactionId,\r\n        value: value,\r\n        currency: \"USD\",\r\n        items: items\r\n    }\r\n    if (tax) ga4.tax = tax;\r\n    if (shipping) ga4.shipping = shipping;\r\n    if (coupon) ga4.coupon = coupon\r\n\r\n    let paymentDetails = {}\r\n    if (paymentType) paymentDetails.payment_type = paymentType;\r\n    if (payerType) paymentDetails.payer_type = payerType;\r\n    if (operationId) paymentDetails.operation_id = operationId;\r\n    if (paymentFlow) paymentDetails.payment_flow = paymentFlow;\r\n    if (coupon) paymentDetails.coupon = coupon;\r\n    if (payment_status) paymentDetails.payment_status = payment_status;\r\n\r\n    pushEcommerceEvent(\"purchase\", ga4, paymentDetails)\r\n}\r\n\r\n/* Fin Funciones Analytics */\r\n\r\nfunction pushEcommerceEvent(eventName, ecommerce, paymentDetails = {}) {\r\n    if (!ecommerce || !Array.isArray(ecommerce.items) || !ecommerce.items.length) return;\r\n\r\n    console.log('DEBUG GA4: ' + eventName);\r\n    const { coupon, payment_type, ...paymentParams } = paymentDetails;\r\n\r\n    let payload = {\r\n        event: eventName,\r\n        ecommerce: { ...ecommerce, ...(coupon ? { coupon } : {}) },\r\n        ...paymentParams\r\n    };\r\n\r\n    if (payment_type) {\r\n        eventName === 'add_payment_info'\r\n            ? payload.ecommerce.payment_type = payment_type\r\n            : payload.payment_type = payment_type;\r\n    }\r\n\r\n    dataLayer.push({ ecommerce: null });\r\n    dataLayer.push(payload);\r\n    //console.log('DEBUG GA4: ' + eventName + ' => ' + JSON.stringify(dataLayer[dataLayer.length - 1]));\r\n    console.log(dataLayer[dataLayer.length - 1]);\r\n}\r\n\r\n\r\nfunction sumItemsValue(items) {\r\n    return items.reduce(function (acc, it) {\r\n        let price = Number(it.price) || 0;\r\n        return acc + price;\r\n    }, 0);\r\n}\r\n\r\n\r\nfunction getUpgradesWithIndex(priceDetail, jsUpgrades) {\r\n    if (!priceDetail || !Array.isArray(priceDetail.upgrades) || !Array.isArray(jsUpgrades)) {\r\n        return [];\r\n    }\r\n    return priceDetail.upgrades.map(function (u) {\r\n        let index = -1;\r\n\r\n        for (let i = 0; i < jsUpgrades.length; i++) {\r\n            if (String(jsUpgrades[i].IdProductoAdicional) === String(u.id)) {\r\n                index = i;\r\n                break;\r\n            }\r\n        }\r\n\r\n        if (index === -1) {\r\n            return null;\r\n        }\r\n\r\n        return {\r\n            upgrade: jsUpgrades[index],\r\n            index: index,\r\n            detallePrecio: u\r\n        };\r\n    }).filter(function (x) { return !!x; });\r\n}\r\n\r\nfunction getUpgradesFromAnalyticsObj(jsProductosAdicionales, jsProductoElegido) {\r\n    if (Array.isArray(jsProductosAdicionales) && jsProductosAdicionales.length > 0) {\r\n        return jsProductosAdicionales\r\n            .map(function (upg, idx) {\r\n                return new UpgradeItemGA4(\r\n                    upg,\r\n                    jsProductoElegido,\r\n                    null,\r\n                    1 + idx\r\n                ).toGA4();\r\n            });\r\n    }\r\n}\r\n\r\nfunction isAlreadySubmit($form) {\r\n    if ($form.data(\"ga-addtocart-sent\")) {\r\n        return true;\r\n    }\r\n    $form.data(\"ga-addtocart-sent\", true);\r\n    return false;\r\n}\r\n\r\nfunction isAvailableInView(variableName) {\r\n    try {\r\n        return typeof window[variableName] !== \"undefined\";\r\n    } catch (e) {\r\n        console.warn(e);\r\n        return false;\r\n    }\r\n}\r\n/*function obtenerPreCompras(productoCodigo, agencia, urlPreCompra) {\r\n    $.ajax({\r\n        type: 'POST',\r\n        url: urlPreCompra,\r\n        data: JSON.stringify({ agencia: agencia, producto: productoCodigo }),\r\n        dataType: 'text',\r\n        contentType: 'application/json; charset=utf-8',\r\n        async: false\r\n    })\r\n}\r\n*/\r\n$(document).ready(function () {\r\n    if (pasoActual === 3) {\r\n        if (!isAvailableInView(\"jsProductos\")) {\r\n            return;\r\n        }\r\n        if (!Array.isArray(jsProductos)) {\r\n            return;\r\n        }\r\n        let itemsGA4 = jsProductos.map(function (p, i) {\r\n            return new ItemGA4(p, i).toGA4();\r\n        });\r\n        viewItemAnalytics(itemsGA4);\r\n        $(\".formProductoSeleccionado\").on(\"submit\", function () {\r\n\r\n            if (isAlreadySubmit($(this))) {\r\n                return;\r\n            }\r\n\r\n            let codigoSeleccionado = $(this).find(\"input[name='ProductoSeleccionado']\").val();\r\n            if (!codigoSeleccionado) return;\r\n\r\n            let producto = jsProductos.find(function (p) {\r\n                return p.Codigo === codigoSeleccionado;\r\n            });\r\n\r\n            if (!producto) {\r\n                return;\r\n            }\r\n            let item = new ItemGA4(producto, 0).toGA4();\r\n\r\n            addBaseProductToCartAnalytics(item);\r\n        });\r\n        $(document).on('submit', '.formPrecompra', function (e) {\r\n            if (isAlreadySubmit($(this))) {\r\n                return;\r\n            }\r\n            let $elementoElegido = $('input[name=\"radio-precompras\"]:checked')\r\n            let index = $elementoElegido.data(\"index\");\r\n            let productoBaseElegido = jsProductos[index]\r\n            const numeroPrecompra = $(this)\r\n                .find('input[name=\"NumeroPrecompra\"]')\r\n                .val();\r\n\r\n\r\n            const titulo = $('.subtitulo').filter(function () {\r\n                return $(this).text().trim() === numeroPrecompra;\r\n            }).closest('.encabezado')\r\n                .find('.titulo')\r\n                .text()\r\n                .trim();\r\n\r\n            productoBaseElegido.PreCompraNombre = titulo\r\n            let item = new ItemGA4(productoBaseElegido, 0, true).toGA4();\r\n            addBaseProductToCartAnalytics(item);\r\n        });\r\n    }\r\n\r\n    if (pasoActual === 4) {\r\n        if (!isAvailableInView(\"productoSeleccionado\")) {\r\n            return;\r\n        }\r\n        if (Array.isArray(jsUpgrades) && jsUpgrades.length) {\r\n            let itemsUpgradesGA4 = jsUpgrades.map(function (u, i) {\r\n                u.PrecioLista = obtenerPrecioUpgrade(u, i);\r\n                return new UpgradeItemGA4(u, productoSeleccionado, null, i).toGA4();\r\n            });\r\n            viewItemUpgradesAnalytics(itemsUpgradesGA4);\r\n            $(\"#formAdicionalesEmision\").on(\"submit\", function () {\r\n                if (isAlreadySubmit($(this))) {\r\n                    return;\r\n                }\r\n                \r\n                let elegidos = getUpgradesWithIndex(priceDetail, jsUpgrades);\r\n                let itemsSeleccionados = elegidos.map(function (x, idx) {\r\n                    return new UpgradeItemGA4(\r\n                        x.upgrade,\r\n                        productoSeleccionado,\r\n                        x.detallePrecio, // precio/cantidad concretos\r\n                        idx\r\n                    ).toGA4();\r\n                });\r\n                addToCartUpgradesAnalytics(itemsSeleccionados);\r\n            });\r\n        }\r\n    }\r\n\r\n    if (pasoActual === 5) {\r\n        if (!esPrecompra) {\r\n            return;\r\n        }\r\n        $(\"#formCompletarPasajeros\").on('submit', function () {\r\n            if (isAlreadySubmit($(this))) {\r\n                return;\r\n            }\r\n            jsProductoElegido.PreCompraNombre = jsProductoPrecompra.Producto;\r\n            let allItems = new ItemGA4(jsProductoElegido, 0, true).toGA4(); \r\n            beginCheckoutAnalytics([allItems], null);\r\n        });\r\n    }\r\n\r\n    if (pasoActual === 7) {\r\n\r\n        if (!isAvailableInView(\"jsProductoElegido\")) {\r\n            return;\r\n        }\r\n\r\n        let itemBase = new ItemGA4(jsProductoElegido, 0).toGA4();\r\n        let coupon = jsProductoElegido.Cupon || null;\r\n        let upgradeItems = [];\r\n\r\n        upgradeItems = getUpgradesFromAnalyticsObj(jsProductosAdicionales, jsProductoElegido)\r\n\r\n        let allItems = [itemBase].concat(upgradeItems || []);\r\n\r\n        if (isAvailableInView(\"esPantallaPago\")) {\r\n            if (!esPantallaPago) {\r\n                return;\r\n            }\r\n            $(\"#formConfirmaCompra\").on(\"submit\", function () {\r\n\r\n                if (isAlreadySubmit($(this))) {\r\n                    return;\r\n                }\r\n\r\n                let quienPaga = $(\"#textpaga\").text();\r\n                let formaPagoText = $('#FormularioCompra_FormaPago option:selected').text();\r\n                let tarjetaEntidad = $('#ddMedioCobro option:selected').text();\r\n                let cuotas = $(\"#ddCuotas option:selected\").text();\r\n\r\n                let operationId = null;\r\n                if (isAvailableInView(\"jsPropuestaId\") && formaPagoText === \"Link de pago\") {\r\n                    operationId = jsPropuestaId;\r\n                }\r\n                let paymentFlow; \r\n                if (formaPagoText === \"Link de pago\" && quienPaga === \"Pasajero\") {\r\n                    paymentFlow = \"passenger_link\";\r\n                } else {\r\n                    paymentFlow = \"partner_direct\";\r\n                }\r\n\r\n                let medioPago = `Tarjeta de credito | ${tarjetaEntidad} | ${cuotas} | ${formaPagoText}`\r\n\r\n                addPaymentInfoAnalytics(allItems, medioPago, coupon, quienPaga,operationId,)\r\n            })\r\n            return;\r\n        }\r\n\r\n        beginCheckoutAnalytics(allItems, coupon);\r\n\r\n        $(\"#formEmitir\").on(\"submit\", function (e) {\r\n            const $form = $(this);\r\n            if (isAlreadySubmit($form)) return;\r\n\r\n            const selected =\r\n                $form.find(\"input#MedioPagoSeleccionadoCC:checked, input#MedioPagoSeleccionadoTB:checked\").val() || null;\r\n\r\n            const medioPagoMap = { CC: \"Cuenta Corriente\", TB: \"Transferencia bancaria\" };\r\n            const medioPago = medioPagoMap[selected];\r\n            if (!medioPago) return; // no era CC/TB o no había selección\r\n\r\n            const quienPaga = $form.find(\"#QuienPaga option:selected\").text() === \"Pasajero\" ? \"pasajero\" : \"partner\";\r\n            addPaymentInfoAnalytics(allItems, medioPago, coupon, quienPaga);\r\n        });\r\n\r\n    }\r\n\r\n    if (pasoActual === 8) //pantalla de confirmación, acá va todo lo referido a link de pago o ejecuciones cuando la tarjeta es valida\r\n    {\r\n        if (!isAvailableInView(\"jsProductoElegido\")) {\r\n            return;\r\n        }\r\n        \r\n        let itemBase = new ItemGA4(jsProductoElegido, 0).toGA4();\r\n\r\n        let itemBasePrecompra;\r\n\r\n\r\n        let upgradeItems = []\r\n        let allItems = []\r\n        if (!esPrecompra) {\r\n            upgradeItems = getUpgradesFromAnalyticsObj(jsProductosAdicionales, jsProductoElegido)\r\n            \r\n            allItems = [itemBase].concat(upgradeItems || []);\r\n        } else {\r\n            itemBasePrecompra = new ItemGA4(jsProductoElegido, 0,true).toGA4();\r\n            allItems = [itemBasePrecompra];\r\n            if (esCargaPasajeros) {\r\n                beginCheckoutAnalytics(allItems, null);\r\n            }\r\n        }\r\n        let operationId = null;\r\n        if (isAvailableInView(\"jsPropuestaId\")) {\r\n            operationId = jsPropuestaId;\r\n        }\r\n        let payment_status = null;\r\n        if (isAvailableInView(\"paymentStatus\")) {\r\n            payment_status = paymentStatus\r\n        }\r\n\r\n        if (esPrecompra) {\r\n            purchaseAnalytics(allItems, null, transactionId)\r\n        } else {\r\n            purchaseAnalytics(allItems, null, transactionId, operationId,null, payerType, paymentFlow, paymentType, null, payment_status)\r\n        }\r\n    }\r\n});"
          },
