            "text": "\r\n/* Recotizardor mobile */\r\n.offcanvas-form {\r\n\t--bs-offcanvas-width: 430px;\r\n\t--bs-offcanvas-padding-x:15px;\r\n\t--bs-offcanvas-padding-y:10px;\r\n\t--bs-offcanvas-color:#fff;\r\n\t--bs-offcanvas-bg:#002A67;\r\n\t--bs-offcanvas-border-width:0;\r\n\t--bs-offcanvas-title-line-height:57px;\r\n\t\r\n\t--bs-form-invalid-color:#FF698B;\r\n}\r\n\r\n.offcanvas-form .legend01 {padding:0 0 4px; color:#fff;}\r\n\r\n.offcanvas-form .note {text-align:center; color:#fff;}\r\n\r\n.offcanvas-form .inputs-edades .form-control {max-width:60px;}\r\n\r\n.offcanvas-form .field-validation-error {\r\n\tfont-size:16px; font-weight:600; line-height:125%; \r\n\tbackground-image:url(\"data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' width='16' height='16' fill='none' stroke='%23FF698B'%3e%3Ccircle stroke='%23FF698B' cx='8' cy='8' r='6' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath stroke='%23FF698B' stroke-linecap='round' stroke-linejoin='round' d='M8 5.336v2.667M8 10.67h.007'/%3E%3c/svg%3e\");\r\n\tbackground-size:20px 20px;\r\n}\r\n\r\n\r\n\r\n\r\n/* recotizador desktop*/\r\n.recotizador-desktop-form {\r\n\t--bs-form-invalid-color:#FF698B;\r\n}\r\n\r\n.recotizador-desktop-form .legend01 {padding:0 0 4px;}\r\n\r\n.recotizador-desktop-form .note {text-align:left; color:#595959;}\r\n\r\n.recotizador-desktop-form .inputs-edades .form-control {max-width:50px;}\r\n\r\n.recotizador-desktop-form .field-validation-error {\r\n\tfont-size:13px; font-weight:600; line-height:125%; \r\n\tpadding-left:21px; margin-top:10px;\r\n\tbackground-image:url(\"data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' width='16' height='16' fill='none' stroke='%23FF698B'%3e%3Ccircle stroke='%23FF698B' cx='8' cy='8' r='6' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath stroke='%23FF698B' stroke-linecap='round' stroke-linejoin='round' d='M8 5.336v2.667M8 10.67h.007'/%3E%3c/svg%3e\");\r\n}\r\n"
