                              tarjetas += '<div class=\"nota\">Precio pactado ' + formatearPrecio(p.PrecioPactado, p.Moneda) + '</div>';\r\n                                }\r\n                                tarjetas += '</div>';\r\n                                tarjetas += '<div class=\"col2\">';\r\n                                tarjetas += '<form method=\"post\" class=\"formPrecompra\" action=\"/portal-de-partners-completar-datos-de-pasajeros\">';\r\n                                tarjetas += '<input type=\"hidden\" name=\"ProductoSeleccionado\" id=\"ProductoSeleccionado-' + codigo + '\" value=\"' + codigo + '\" />';\r\n                                tarjetas += '<input type=\"hidden\" name=\"NumeroPrecompra\" id=\"NumeroPrecompra-' + p.CodigoUA + '\" value=\"' + p.CodigoUA + '\" />';\r\n                                tarjetas += '<button class=\"btn btn-sm ' + (esTipoPuestoCotizador ? 'disabled white-color' : '') +' \" type=\"submit\">Emitir</button>';\r\n                                tarjetas += '</form>';\r\n                                tarjetas += '</div>';\r\n                                tarjetas += '</div>';\r\n                                tarjetas += '</div>';\r\n                                tarjetas += '</div>';\r\n                                $('#divPrecompras').html(tarjetas);\r\n                            }\r\n                        }\r\n                    });\r\n                });\r\n\r\n                function formatearPrecio(precio, moneda = '') {\r\n                    return (moneda == '' ? '' : moneda + ' ') + Globalize.format(precio, 'N2').replace(',00', '');\r\n                }\r\n\r\n                $('#btnDescargarCotizacion').click(function (e) {\r\n                    $('#descargaForm .msg').addClass('d-none');\r\n                    var selRowIds = getProductosSeleccionados();\r\n                    var nombrePDF = 'CotizacionEmisionPDF';\r\n                    if (selRowIds != null) {\r\n                     