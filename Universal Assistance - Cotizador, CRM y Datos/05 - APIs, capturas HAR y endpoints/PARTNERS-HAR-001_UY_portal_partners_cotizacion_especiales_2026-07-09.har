            "mimeType": "application/javascript",
            "text": "function maskDateInput(input) {\r\n    var value = input.val();\r\n    var formattedInput = value.replace(/\\D/g, '');\r\n\r\n    if (formattedInput.length > 2) {\r\n        formattedInput = formattedInput.replace(/^(\\d{2})/, '$1/');\r\n    }\r\n    if (formattedInput.length > 5) {\r\n        formattedInput = formattedInput.replace(/^(\\d{2})\\/(\\d{2})/, '$1/$2/');\r\n    }\r\n    if (formattedInput.length > 10) {\r\n        formattedInput = formattedInput.substring(0, 10);\r\n    }\r\n\r\n    input.val(formattedInput);\r\n}\r\n"
          },
