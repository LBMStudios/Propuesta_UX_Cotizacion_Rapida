field-validation-error field-validation-no-icon validation-error-inline\">La fecha de nacimiento ingresada es inválida.</span>');\r\n                            } else if (fecnacVacias) {\r\n                                $('#fecnac').after('<span class=\"field-validation-error field-validation-no-icon validation-error-inline\">Debe completar todas las fechas de nacimiento.</span>');\r\n                            }\r\n                            $('#ListaFecNac').val(listaFechas.slice(0, -1));\r\n                            break;\r\n                    }\r\n                    if (!isValid) {\r\n                        e.preventDefault();\r\n                        $('#formCotizacion button[type=\"submit\"]').attr('disabled', false).html('Recotizar');\r\n                        return false;\r\n                    }\r\n                });\r\n                $('.vermas').click(function (e) {\r\n                    var id = $(this).attr('id');\r\n                    var producto = ($.grep(jsProductos, function (i) { return i.Codigo == id; }))[0];\r\n                    if (producto.EsAnual) {\r\n                        $('#detCoberturas').addClass('modal-detalle-cobertura-anual').removeClass('modal-detalle-cobertura-diario');\r\n                    }\r\n                    else {\r\n                        $('#detCoberturas').addClass('modal-detalle-cobertura-diario').removeClass('modal-detalle-cobertura-anual');\r\n                    }\r\n                    var tit = producto.DescripcionLarga.replaceAll(')', '').split('(');\r\n                    $('#detCoberturasLabel').html(tit[0]);\r\n                    if (tit.length > 1) { $('#detCoberturasSubLabel').html(tit[1]); }\r\n                    getTablaCoberturas(producto);\r\n                    e.preventDefault();\r\n                    $('#detCoberturas').modal('show');\r\n                });\r\n                function getTablaCoberturas(producto) {\r\n                    showModalCobertura(producto);\r\n\r\n                    $('#formSelProdCode').val(producto.Codigo);\r\n                }\r\n                $('#formSelProd').on('submit', function (e) {\r\n                    e.preventDefault();\r\n                    var url = '/Emision/ImprimirDetalleProducto?codigoProducto=' + $('#formSelProdCode').val();\r\n                    window.open(url, '_blank');\r\n                    return false;\r\n                });\r\n                $('input[name=\"radio-precompras\"]').on('click', function () {\r\n                    $('.cabecera-precompra').addClass('d-none');\r\n                    $('#divPrecompras').removeClass('text-center').html('');\r\n                    var codigo = $(this).attr('id').replace('radio-', '');\r\n                    $.ajax({\r\n                        type: 'POST',\r\n                        url: '/Emision/GetNumerosPrecompra',\r\n                        data: JSON.stringify({ agencia: '1-QN2H3', producto: codigo }),\r\n                        dataType: 'text',\r\n                        contentType: 'application/json; charset=utf-8',\r\n                        async: false\r\n                    })\r\n                    .done(function (data) {\r\n                        $('.cabecera-precompra').removeClass('d-none');\r\n                        var jData = JSON.parse(data);\r\n                        if (jData.rowCount == 0) {\r\n                            $('#divPrecompras').addClass('text-center').html('<span style=\"color:red;\">No hay Precompras con saldo disponible para el producto seleccionado</span>');\r\n                        }\r\n                        else {\r\n                            var multiplicador = parseInt('1');\r\n                            var precompras = JSON.parse(jData.precompras);\r\n                            var tarjetas = '';\r\n                            for (var i = 0; i < jData.rowCount; i++) {\r\n                                var p = precompras.ListPrecompras[i];\r\n                              