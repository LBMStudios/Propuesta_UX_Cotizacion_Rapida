    Paso 6: Selección de medio de pago\r\n    Paso 7: Selección de medio de pago\r\n    Paso 8: Confirmación\r\n-->\r\n\r\n<div class=\"navbar-progress\">\r\n    <div class=\"navbar-progress-step navbar-progress-step--on\">Coberturas</div>\r\n\r\n\r\n    <div class=\"navbar-progress-step \">Pasajeros</div>\r\n\r\n        <div class=\"navbar-progress-step \">\r\n            Pago <span class=\"d-none d-sm-inline\">y facturación</span>\r\n        </div>\r\n\r\n    <div class=\"navbar-progress-step \">\r\n        <span class=\"d-none d-sm-inline\">Confirmación</span>\r\n        <span class=\"d-inline d-sm-none\">Checkout</span>\r\n    </div>\r\n</div>\r\n\r\n\r\n        <div class=\"row\">\r\n\r\n            <div class=\"d-none d-lg-block col-lg-auto w-330p mb-80\">\r\n\r\n                <div class=\"box rounded-3 px-15 py-20 mb-10\">\r\n                    <div class=\"sec-title01 text-center mb-15\">Asistencia al viajero</div>\r\n\r\n                        <!-- Recotizador -->\r\n                            <div class=\"\" id=\"recotizadorDetalle\">\r\n                                <div class=\"tbl01 mb-0\">\r\n                                    <dl>\r\n                                        <div>\r\n                                            <dt>TIPO DE PRODUCTO:</dt>\r\n                                            <dd>Especiales</dd>\r\n                                        </div>\r\n                                        <div>\r\n                                            <dt>TIPO DE VIAJE:</dt>\r\n                                            <dd>Un viaje</dd>\r\n                                        </div>\r\n                                        <div>\r\n                                            <dt>DESTINO:</dt>\r\n                                            <dd>M&#250;ltiples Destinos*</dd>\r\n                                        </div>\r\n                                        <div>\r\n                                            <dt>FECHAS:<