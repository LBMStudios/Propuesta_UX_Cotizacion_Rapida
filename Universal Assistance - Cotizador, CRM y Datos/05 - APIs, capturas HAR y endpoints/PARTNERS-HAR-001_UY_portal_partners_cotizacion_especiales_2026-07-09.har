            "text": "/*\r\nfunction getSpanValues() {\r\n    spanEmailValue = $('#spanValidEmail').html();\r\n    spanPass1Value = $('#spanValidPassword').html();\r\n    spanPass2Value = $('#spanValidPassword2').html();\r\n    txtEmailValue = $('#emailTextbox').val();\r\n    txtPass1Value = $('#password').val();\r\n    txtPass2Value = $('#password2').val();\r\n}\r\n*/\r\n\r\n$(document).ready(function () {\r\n    /*\r\n\t$('#emailTextbox').focus();\r\n    $('#password').focus();\r\n    $('#spanValidEmail, #spanValidPassword, #spanValidPassword2').on('DOMSubtreeModified', function (evenT) {\r\n        getSpanValues();\r\n        mainIdsJs.enableSubmit(spanEmailValue == '' && spanPass1Value == '' && spanPass2Value == '');\r\n    });\r\n    $('#emailTextbox, #password, #password2').on('input', function (evenT) {\r\n        getSpanValues();\r\n        mainIdsJs.enableSubmit(validationService1.isValid(formRegister, false)\r\n            && txtEmailValue != '' && txtPass1Value != '' && txtPass2Value != '');\r\n    });\r\n    $('#emailTextbox, #password, #password2').on('change', function (evenT) {\r\n        getSpanValues();\r\n        mainIdsJs.enableSubmit(validationService1.isValid(formRegister, false)\r\n            && txtEmailValue != '' && txtPass1Value != '' && txtPass2Value != '');\r\n    });\r\n\t*/\r\n\r\n    const togglePassword = document.querySelector('#togglePassword');\r\n    const password = document.querySelector('#password');\r\n    if (togglePassword) {\r\n        togglePassword.addEventListener('click', () => {\r\n\r\n            // Toggle the type attribute using\r\n            // getAttribure() method\r\n            const type = password\r\n                .getAttribute('type') === 'password' ?\r\n                'text' : 'password';\r\n\r\n            password.setAttribute('type', type);\r\n\r\n            // Toggle the eye and eye-off icon\r\n            if ($('#togglePassword').attr('class') == 'input-icon icon-eye-off') {\r\n                $('#togglePassword').removeClass('input-icon icon-eye-off');\r\n                $('#togglePassword').addClass('input-icon icon-eye');\r\n            } else {\r\n                $('#togglePassword').removeClass('input-icon icon-eye');\r\n                $('#togglePassword').addClass('input-icon icon-eye-off');\r\n            }\r\n        });\r\n\t\t/*\r\n        const passwordSelect = document.querySelector('#password');\r\n        const passwordSelect2 = document.querySelector('#password2');\r\n        passwordSelect.addEventListener(\"click\", () => {\r\n            $('#togglePassword').css('color', '#002A67');\r\n        });\r\n        passwordSelect2.addEventListener(\"click\", () => {\r\n            $('#togglePassword2').css('color', '#002A67');\r\n        });\r\n\t\t*/\r\n    }\r\n});\r\n\r\nfunction ShowEye() {\r\n    const password = document.querySelector('#password2');\r\n\r\n    const type = password\r\n        .getAttribute('type') === 'password' ?\r\n        'text' : 'password';\r\n\r\n    password.setAttribute('type', type);\r\n\r\n    // Toggle the eye and bi-eye icon\r\n    if ($('#togglePassword2').attr('class') == 'bi bi-eye-slash') {\r\n        $('#togglePassword2').removeClass('bi bi-eye-slash');\r\n        $('#togglePassword2').addClass('bi bi-eye');\r\n    } else {\r\n        $('#togglePassword2').removeClass('bi bi-eye');\r\n        $('#togglePassword2').addClass('bi bi-eye-slash');\r\n    }\r\n}\r\n"
          },
