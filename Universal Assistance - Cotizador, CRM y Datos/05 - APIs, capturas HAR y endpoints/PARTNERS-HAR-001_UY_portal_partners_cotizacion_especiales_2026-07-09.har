          "cookies": [],
          "content": {
            "size": 11279,
            "mimeType": "application/javascript",
            "text": "\r\nfunction getCookie(name, valor) {\r\n    var cookies = document.cookie.split(\"; \");\r\n    for (var i = 0; i < cookies.length; i++) {\r\n        var parts = cookies[i].split(\"=\");\r\n        if (parts[0] === name) {\r\n            return parts[1];\r\n        }\r\n    }\r\n    return false;\r\n}\r\n\r\nfunction validarSiTieneLimiteDeCredito(e) {\r\n    var formulario = $(\"#formAdicionalesEmision\");\r\n\r\n    if (formulario.data('submitted')) {\r\n        return;\r\n    }\r\n\r\n    $('#formAdicionalesEmision button[type=\"submit\"]')\r\n        .html('<span class=\"spinner-border spinner-border-sm\" role=\"status\" aria-hidden=\"true\"></span>')\r\n        .attr('disabled', true);\r\n\r\n    if (poseeCC) {\r\n        e.preventDefault();\r\n        ValidarPopupAdicionales(formulario);\r\n    }\r\n}\r\n\r\nfunction ValidarPopupAdicionales(formulario) {\r\n    var productoSeleccionado = limiteCreditoVM.ProductoSeleccionado;\r\n    var formData = formulario.serializeArray();\r\n\r\n    var model = {};\r\n    $.each(formData, function (i, field) {\r\n        model[field.name] = field.value;\r\n    });\r\n\r\n    model.propuestaEmisionId = limiteCreditoVM.PropuestaEmisionId;\r\n    model.productoSeleccionado = productoSeleccionado;\r\n    model.paso = limiteCreditoVM.PasoActual;\r\n    model.pais = limiteCreditoVM.Origen;\r\n\r\n    $.ajax({\r\n        type: 'POST',\r\n        url: validarPopupLimiteCreditoAdicionalesUrl,\r\n        timeout: 180000,\r\n        data: JSON.stringify(model),\r\n        contentType: 'application/json; charset=utf-8',\r\n        dataType: 'json',\r\n        success: function (response) {\r\n\r\n            if (response.mostrarPopup == null) {\r\n                formulario.data('submitted', true);\r\n                formulario.submit();\r\n                return\r\n            }\r\n            if (!response.mostrarPopup.ErrorRequest) {\r\n                if (response.mostrarPopup.PopupB) {\r\n                    mostrarPopup('#popup-limite-credito-b');\r\n                    window.formToSubmit = formulario;\r\n                    return;\r\n                }\r\n\r\n                if (response.mostrarPopup.PopupC) {\r\n                    mostrarPopup('#popup-limite-credito-c');\r\n                    window.formToSubmit = formulario;\r\n                    return;\r\n                }\r\n\r\n                formulario.data('submitted', true);\r\n                formulario.submit();\r\n            } else {\r\n                if (response.mostrarPopup.HayEmisoresParaPais) {\r\n                    mostrarPopup('#popup-limite-credito-err-si-med-cobro');\r\n                } else {\r\n                    mostrarPopup('#popup-limite-credito-err-no-med-cobro');\r\n                }\r\n                window.formToSubmit = formulario;\r\n                return;\r\n            }\r\n        },\r\n        error: function () {\r\n\r\n            formulario.data('submitted', true);\r\n            formulario.submit();\r\n        }\r\n    });\r\n}\r\n\r\nfunction ValidarPopup(formulario) {\r\n    var productoSeleccionado = limiteCreditoVM.ProductoSeleccionado;\r\n\r\n    $.ajax({\r\n        type: 'POST',\r\n        url: validarPopupLimiteCreditoEmisionUrl,\r\n        timeout: 180000,\r\n        data: JSON.stringify({\r\n            propuestaEmisionId: limiteCreditoVM.PropuestaEmisionId,\r\n            productoSeleccionado: productoSeleccionado,\r\n            paso: limiteCreditoVM.PasoActual,\r\n            pais: limiteCreditoVM.Origen,\r\n        }),\r\n        contentType: 'application/json; charset=utf-8',\r\n        dataType: 'json',\r\n        success: function (response) {\r\n\r\n            if (response.mostrarPopup == null) {\r\n                //puede pasar por que la sesi�n est� finalizada, luego de hacer el submit se reenviar� a donde corresponda\r\n                formulario.data('submitted', true);\r\n                formulario.submit();\r\n                return\r\n            }\r\n            if (!response.mostrarPopup.ErrorRequest) {\r\n                if (response.mostrarPopup.PopupB) {\r\n                    mostrarPopup('#popup-limite-credito-b');\r\n                    window.formToSubmit = formulario;\r\n                    return;\r\n                }\r\n\r\n                if (response.mostrarPopup.PopupC) {\r\n                    mostrarPopup('#popup-limite-credito-c');\r\n                    window.formToSubmit = formulario;\r\n                    return;\r\n                }\r\n\r\n                formulario.data('submitted', true);\r\n                formulario.submit();\r\n            } else {\r\n                if (response.mostrarPopup.HayEmisoresParaPais) {\r\n                    mostrarPopup('#popup-limite-credito-err-si-med-cobro');\r\n                } else {\r\n                    mostrarPopup('#popup-limite-credito-err-no-med-cobro');\r\n                }\r\n                window.formToSubmit = formulario;\r\n                return;\r\n            }\r\n        },\r\n        error: function () {\r\n\r\n            formulario.data('submitted', true);\r\n            formulario.submit();\r\n        }\r\n    });\r\n\r\n}\r\n\r\nfunction mostrarPopup(selector) {\r\n    $.blockUI({\r\n        message: $(selector),\r\n        css: {\r\n            top: '50%',\r\n            left: '50%',\r\n            transform: 'translate(-50%, -50%)',\r\n            backgroundColor: 'white',\r\n            padding: '20px',\r\n            borderRadius: '10px',\r\n            border: '1px solid #ccc'\r\n        },\r\n        onBlock: function () {\r\n            $('.blockUI.blockMsg').attr('id', 'blockUI-popup');\r\n        }\r\n    });\r\n}\r\n\r\nfunction continuarPopup() {\r\n    $.unblockUI();\r\n    if (window.formToSubmit) {\r\n        window.formToSubmit.data('submitted', true);\r\n        window.formToSubmit.submit();\r\n    }\r\n}\r\n\r\nfunction cancelarPopup() {\r\n    $.unblockUI();\r\n    window.location.href = homeUrl;\r\n}\r\n\r\nfunction cerrarPopup() {\r\n    $.unblockUI();\r\n}\r\n\r\nfunction validarLimiteCreditoPasajeros($form, e) {\r\n\r\n    var poseeCC = limiteCreditoVM.TieneCC;\r\n\r\n    if (!poseeCC) {\r\n        return;\r\n    }\r\n\r\n    if ($form.data('submitted')) {\r\n        return true;\r\n    }\r\n\r\n    e.preventDefault();\r\n    window.formToSubmit = $form;\r\n\r\n    var productoSeleccionado = limiteCreditoVM.ProductoSeleccionado\r\n    var paso = limiteCreditoVM.PasoActual;\r\n\r\n    $.ajax({\r\n        type: 'POST',\r\n        url: validarPopupLimiteCreditoEmisionUrl,\r\n        data: JSON.stringify({\r\n            propuestaEmisionId: limiteCreditoVM.PropuestaEmisionId,\r\n            productoSeleccionado: productoSeleccionado,\r\n            paso: paso,\r\n            pais: limiteCreditoVM.Origen,\r\n        }),\r\n        timeout: 180000,\r\n        contentType: 'application/json; charset=utf-8',\r\n        dataType: 'json',\r\n        success: function (response) {\r\n            if (!response.mostrarPopup.ErrorRequest) {\r\n                if (response.mostrarPopup.EmitirCC) {\r\n                    enviandoFormulario = true;\r\n                    $form.off('submit');\r\n                    $form.submit();\r\n                }\r\n                if (response.mostrarPopup.MostrarPopup) {\r\n                    if (response.mostrarPopup.PopupC) {\r\n                        window.mostrarPopup('#popup-limite-credito-c')\r\n                    }\r\n                } else {\r\n                    enviandoFormulario = true;\r\n                    $form.off('submit');\r\n                    $form.submit();\r\n                }\r\n            } else {\r\n                if (response.mostrarPopup.HayEmisoresParaPais) {\r\n                    window.mostrarPopup('#popup-limite-credito-err-si-med-cobro')\r\n                } else {\r\n                    window.mostrarPopup('#popup-limite-credito-err-no-med-cobro')\r\n                }\r\n            }\r\n        },\r\n        error: function () {\r\n            enviandoFormulario = true;\r\n            $form.off('submit');\r\n            $form.submit();\r\n        }\r\n    });\r\n\r\n}\r\n\r\n$(document).ready(function () {\r\n\r\n    if (limiteCreditoVM.PasoActual == 1) {\r\n        var mostrarPopup = limiteCreditoVM.MostrarPopup;\r\n        var mostrarPopupError = limiteCreditoVM.MostrarPopupError;\r\n        var agencia = limiteCreditoVM.Agencia;\r\n        var usuario = limiteCreditoVM.Usuario;\r\n        var cookieGuardada = getCookie(usuario + \"|\" + agencia, true);\r\n        if (mostrarPopup && !mostrarPopupError && !cookieGuardada) {\r\n            $.blockUI({\r\n                message: $('#popup-limite-credito-a'),\r\n                css: {\r\n                    top: '50%',\r\n                    left: '50%',\r\n                    transform: 'translate(-50%, -50%)',\r\n                    backgroundColor: 'white',\r\n                    padding: '20px',\r\n                    borderRadius: '10px',\r\n                    border: '1px solid #ccc'\r\n                },\r\n                onBlock: function () {\r\n                    $('.blockUI.blockMsg').attr('id', 'blockUI-popup');\r\n                }\r\n            });\r\n        }\r\n\r\n        $('#btn-continuar-popup-cc-a').on('click', function () {\r\n            $.ajax({\r\n                type: 'POST',\r\n                url: popupBtnContinuarUrl,\r\n                contentType: 'application/json; charset=utf-8',\r\n                dataType: 'json'\r\n            }).done(function (data) {\r\n            });\r\n            $.unblockUI();\r\n        });\r\n\r\n        $('#btn-recordar-popup-cc').on('click', function () {\r\n            setCookie(usuario + \"|\" + agencia, true, getFechaExpiracionFinDia());\r\n            $.unblockUI();\r\n        });\r\n    }\r\n    if (limiteCreditoVM.PasoActual == 3) {\r\n        var poseeCC = limiteCreditoVM.TieneCC;\r\n\r\n        $(window).on(\"pageshow\", function (event) {\r\n            if (event.originalEvent.persisted) {\r\n                $('.formProductoSeleccionado button[type=\"submit\"]')\r\n                    .html('Seleccionar')\r\n                    .attr('disabled', false);\r\n            }\r\n        });\r\n\r\n        $('.formProductoSeleccionado').on('submit', function (e) {\r\n            var formulario = $(this);\r\n\r\n            if (formulario.data('submitted')) {\r\n                return;\r\n            }\r\n\r\n            $('.formProductoSeleccionado button[type=\"submit\"]')\r\n                .html('<span class=\"spinner-border spinner-border-sm\" role=\"status\" aria-hidden=\"true\"></span>')\r\n                .attr('disabled', true);\r\n\r\n            if (poseeCC) {\r\n                e.preventDefault();\r\n                ValidarPopup(formulario);\r\n            }\r\n        });\r\n    }\r\n\r\n    if (limiteCreditoVM.PasoActual == 3 || limiteCreditoVM.PasoActual == 4 || limiteCreditoVM.PasoActual == 5) {\r\n        $('#btn-continuar-popup-cc-b, #btn-continuar-popup-cc-err-no, #btn-continuar-popup-cc-err-si')\r\n            .on('click', continuarPopup);\r\n\r\n        $('#btn-cancelar-popup-cc-b, #btn-volver-popup-cc, #btn-cancelar-popup-cc-err-no, #btn-cancelar-popup-cc-err-si')\r\n            .on('click', function (e) {\r\n\r\n                if (limiteCreditoVM.PasoActual == 4) {\r\n                    cerrarPopup();\r\n                } else {\r\n                    cancelarPopup();\r\n                }                \r\n            });\r\n\r\n        $(\"#formAdicionalesEmision\").on(\"submit\", function (e) {\r\n            validarSiTieneLimiteDeCredito(e);\r\n        })\r\n    }\r\n})\r\n\r\n$(document).on('click', '.formProductoSeleccionado button[type=\"submit\"]', function (e) {\r\n    var formulario = $(this).closest('form');\r\n    var productoSeleccionado = formulario.find('input[name=\"ProductoSeleccionado\"]').val();\r\n    limiteCreditoVM.ProductoSeleccionado = productoSeleccionado;\r\n});\r\n"
