          "content": {
            "size": 5063,
            "mimeType": "application/javascript",
            "text": "$(document).ready(function () {\r\n    var minDate = moment().startOf('day');\r\n    var maxDate = moment().startOf('day').add(5, 'years');\r\n\r\n    $('#RangoFechas').daterangepicker({\r\n        minDate: minDate,\r\n        maxDate: maxDate,\r\n        locale: {\r\n            format: 'DD/MM/YYYY',\r\n            \"separator\": \" - \",\r\n            \"applyLabel\": \"Aplicar\",\r\n            \"cancelLabel\": \"Borrar\",\r\n            \"fromLabel\": \"Desde\",\r\n            \"toLabel\": \"Hasta\",\r\n            \"customRangeLabel\": \"Custom\",\r\n            \"weekLabel\": \"W\",\r\n            \"daysOfWeek\": [\r\n                \"Do\",\r\n                \"Lu\",\r\n                \"Ma\",\r\n                \"Mi\",\r\n                \"Ju\",\r\n                \"Vi\",\r\n                \"Sá\"\r\n            ],\r\n            \"monthNames\": [\r\n                \"Enero\",\r\n                \"Febrero\",\r\n                \"Marzo\",\r\n                \"Abril\",\r\n                \"Mayo\",\r\n                \"Junio\",\r\n                \"Julio\",\r\n                \"Agosto\",\r\n                \"Septiembre\",\r\n                \"Octubre\",\r\n                \"Noviembre\",\r\n                \"Diciembre\"\r\n            ],\r\n            \"firstDay\": 0\r\n        }\r\n    }, function (start, end, label) {\r\n        $('#FechaInicio').val(start.format('DD/MM/YYYY'));\r\n        $('#FechaFin').val(end.format('DD/MM/YYYY'));\r\n        daterangepickerDatesApplied();\r\n    });\r\n\r\n    $('#FechaInicio, #FechaFin').on('focus', function () {\r\n        if (!$('.daterangepicker').is(':visible')) {\r\n            $('#RangoFechas').data('daterangepicker').toggle();\r\n        }\r\n    });\r\n\r\n    $('#FechaInicio, #FechaFin').on('click', function () {\r\n        if (!$('.daterangepicker').is(':visible')) {\r\n            $('#RangoFechas').data('daterangepicker').toggle();\r\n        }\r\n    });\r\n\r\n    $('#RangoFechas').on('show.daterangepicker', function (ev, picker) {\r\n        observeDrpSelectedSpan();\r\n        observeApplyButton();\r\n\r\n        var diasText = $('.daterangepicker .drp-buttons .drp-selected').text();\r\n        if (diasText.indexOf('Total') == -1) {\r\n            setDiasText();\r\n        }\r\n        if ($('#custom-drp-selected').length == 0) {\r\n            $('<div id=\"custom-drp-selected\"></div>').insertBefore('.daterangepicker .drp-buttons');\r\n            setDiasText();\r\n        }\r\n    });\r\n\r\n    $('#FechaInicio, #FechaFin').on('input', function () {\r\n        $('#RangoFechas').data('daterangepicker')?.hide();\r\n        maskDateInput($(this));\r\n    });\r\n\r\n    function observeDrpSelectedSpan() {\r\n        const drpSelectedSpan = $('.daterangepicker').find('.drp-selected');\r\n        if (drpSelectedSpan.length) {\r\n            const observer = new MutationObserver(function (mutations) {\r\n                mutations.forEach(function (mutation) {\r\n                    if (mutation.target !== null && mutation.target.innerText != null && mutation.target.innerText.indexOf('Total') == -1) {\r\n                        setDiasText();\r\n                    }\r\n                });\r\n            });\r\n            observer.observe(drpSelectedSpan[0], {\r\n                childList: true\r\n            });\r\n        }\r\n    }\r\n\r\n    function observeApplyButton() {\r\n        const applyButton = $('.daterangepicker').find('.applyBtn');\r\n        if (applyButton.length) {\r\n            const observer = new MutationObserver(function (mutations) {\r\n                mutations.forEach(function (mutation) {\r\n                    if (mutation.target !== null && mutation.attributeName === 'disabled') {\r\n                        if (mutation.target.disabled) {\r\n                            if ($('.daterangepicker .start-date').length > $('.daterangepicker .end-date').length) {\r\n                                daterangepickerStartDateSelected();\r\n                            }\r\n                        }\r\n                        else {\r\n                            if ($('.daterangepicker .start-date').length === $('.daterangepicker .end-date').length) {\r\n                                daterangepickerEndDateSelected();\r\n                            }\r\n                        }\r\n                    }\r\n                });\r\n            });\r\n            observer.observe(applyButton[0], {\r\n                attributes: true\r\n            });\r\n        }\r\n    }\r\n\r\n    function setDiasText() {\r\n        var start = $('#RangoFechas').data('daterangepicker').startDate;\r\n        var end = $('#RangoFechas').data('daterangepicker').endDate;\r\n        if (start !== null && end !== null) {\r\n            var dias = (end.diff(start, 'days') + 1);\r\n            $('.daterangepicker .drp-buttons .drp-selected').html('<span style=\"color: gray;\">Total:</span> <span style=\"color: #002a67;\">' + dias + ' dí­a' + (dias > 1 ? 's' : '') + '</span>');\r\n            $('#custom-drp-selected').html('<span style=\"color: gray;\">DESDE:</span> <span style=\"color: #002a67;\">' + start.format('DD/MM/YYYY') + '</span> <span style=\"color: #00C4DF;\">&nbsp;>&nbsp;</span> <br class=\"d-md-none\"><span style=\"color: gray;\">HASTA:</span> <span style=\"color: #002a67;\">' + end.format('DD/MM/YYYY') + '</span>');\r\n        }\r\n    }\r\n});"
          },
