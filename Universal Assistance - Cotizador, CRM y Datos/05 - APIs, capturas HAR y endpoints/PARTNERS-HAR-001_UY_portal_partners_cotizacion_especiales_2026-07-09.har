            "text": "#edades,\r\n#fecnac {\r\n\tdisplay: grid !important;\r\n\tgrid-template-columns: repeat(5, max-content);\r\n\tgap: 0.5rem;\r\n\twidth: fit-content;\r\n}\r\n\r\n@media (max-width: 767px) {\r\n\t#edades {\r\n\t\tgrid-template-columns: repeat(4, max-content);\r\n\t}\r\n\t#fecnac {\r\n\t\tgrid-template-columns: repeat(2, max-content);\r\n\t}\r\n\t.btn-group-pill {\r\n\t\tmargin-left: calc(var(--bs-gutter-x) * -.5);\r\n\t}\r\n}\r\n\r\n.mensaje-importacion {\r\n\ttext-align: right;\r\n\tpadding-top: 4%;\r\n}\r\n\r\n.validation-error-inline {\r\n\tdisplay: block;\r\n}\r\n\r\n.validation-error-importacion-titulo {\r\n\tdisplay: block;\r\n\ttext-align: center;\r\n\tpadding-right: 55%;\r\n}\r\n\r\n.validation-error-importacion-detalle {\r\n\tcolor: #CC3658;\r\n}\r\n\r\n.field-validation-no-icon {\r\n\tpadding-left: 0;\r\n\tbackground-image: none;\r\n}\r\n\r\n.bootstrap-select:has(#Destino) + .field-validation-error {\r\n\tpadding-left: 4%;\r\n}\r\n\r\n.fecha-nac.is-invalid,\r\n#edades input.is-invalid {\r\n\tbackground-image: none;\r\n\tpadding-right: 14px;\r\n}\r\n\r\n#divImportarEdades .field-validation-error {\r\n\tpadding-top: 2%;\r\n}\r\n\r\n#divListaEdades .field-validation-error,\r\n#divListaFecNac .field-validation-error,\r\n#divImportarEdades .field-validation-error {\r\n\ttext-align: center;\r\n\tpadding-left: 0;\r\n\tbackground-image: none;\r\n\tfont-weight: 400;\r\n\tpadding-right: 30%;\r\n}\r\n\r\n#divListaEdades:has(#edades input:nth-child(2)) .field-validation-error {\r\n\tpadding-right: 0;\r\n}\r\n\r\n#divListaFecNac:has(#fecnac input:nth-child(2)) .field-validation-error {\r\n\tpadding-right: 0;\r\n}\r\n"
