          "content": {
            "size": 5845,
            "mimeType": "text/css",
            "text": "/* */\r\n.alink {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    font-size: 14px;\r\n    font-weight: 500;\r\n    line-height: 1;\r\n    color: var(--ua-primary);\r\n    text-decoration: underline;\r\n}\r\n\r\n    .alink:not(:last-of-type) {\r\n        margin-right: 40px;\r\n    }\r\n\r\n.alink-pink {\r\n    color: var(--ua-pink);\r\n}\r\n\r\n.alink-icon .svg-icon {\r\n    width: 18px;\r\n    height: 18px;\r\n    margin-right: 10px;\r\n}\r\n\r\n\r\n\r\n/* */\r\n.box-pasajeros {\r\n    padding: 0 15px;\r\n    color: #002A67;\r\n    --bs-accordion-transition: color 0.15s ease-in-out,background-color 0.15s ease-in-out,border-color 0.15s ease-in-out,box-shadow 0.15s ease-in-out,border-radius 0.15s ease;\r\n    --bs-accordion-btn-icon-transition: transform 0.2s ease-in-out;\r\n    --bs-accordion-btn-icon-transform: rotate(-180deg);\r\n}\r\n\r\n    .box-pasajeros .box-button {\r\n        position: relative;\r\n        display: flex;\r\n        align-items: center;\r\n        flex-wrap: wrap;\r\n        width: 100%;\r\n        padding: 10px 0 5px 0;\r\n        background-color: transparent;\r\n        border: 0;\r\n        overflow-anchor: none;\r\n        transition: var(--bs-accordion-transition);\r\n    }\r\n\r\n        .box-pasajeros .box-button:not(.box-button-no-arrow)::after {\r\n            content: \"\";\r\n            flex-shrink: 0;\r\n            width: 30px;\r\n            height: 30px;\r\n            margin-left: auto;\r\n            background-image: url(\"data:image/svg+xml,%3Csvg width='12' height='9' viewBox='0 0 12 9' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1.41 0.793125L6 5.37313L10.59 0.793125L12 2.20312L6 8.20312L0 2.20312L1.41 0.793125Z' fill='%23002447'/%3E%3C/svg%3E%0A\");\r\n            background-repeat: no-repeat;\r\n            background-position: center;\r\n            background-size: 12px;\r\n            transition: var(--bs-accordion-btn-icon-transition);\r\n        }\r\n\r\n        .box-pasajeros .box-button.box-button-no-arrow {\r\n            cursor: auto;\r\n        }\r\n\r\n        .box-pasajeros .box-button:not(.collapsed)::after {\r\n            transform: var(--bs-accordion-btn-icon-transform);\r\n        }\r\n\r\n        .box-pasajeros .box-button.collapsed .alink {\r\n            display: none;\r\n        }\r\n\r\n        .box-pasajeros .box-button .alink {\r\n            order: 6;\r\n            width: 100%;\r\n            margin: 15px 0 5px;\r\n        }\r\n\r\n\r\n    .box-pasajeros .box-body {\r\n        border-top: 2px solid #DCDCDC;\r\n        padding: 15px 0 10px;\r\n    }\r\n\r\n    .box-pasajeros .section-title {\r\n        padding: 5px 0;\r\n        margin: 10px 0 15px;\r\n        border-bottom: 2px solid #DCDCDC;\r\n    }\r\n\r\n\r\n\r\n@media (min-width: 992px) {\r\n\r\n    .box-pasajeros {\r\n        padding: 0 20px;\r\n    }\r\n\r\n        .box-pasajeros .box-button .alink {\r\n            order: 0;\r\n            width: auto;\r\n            margin: 0 0 0 70px;\r\n        }\r\n}\r\n\r\n@media (max-width: 500px) {\r\n    .box-button.collapsed .contenedor-upgrades-inline {\r\n        padding-top: 3px;\r\n    }\r\n    .box-pasajeros .box-button {\r\n        width: 108%;\r\n        padding: 5px 0 5px 0;\r\n    }\r\n    .badge-desktop-only {\r\n        display: none !important;\r\n    }\r\n}\r\n    /* */\r\n    .visor-footer .trigger {\r\n        position: absolute;\r\n        right: 0;\r\n        bottom: 4px;\r\n    }\r\n\r\n        .visor-footer .trigger .svg-icon {\r\n            transition: transform 0.2s ease-in-out;\r\n        }\r\n\r\n        .visor-footer .trigger:not(.collapsed) .svg-icon {\r\n            transform: rotate(-180deg);\r\n        }\r\n\r\n\r\n\r\n\r\n    /* */\r\n    .box-pagos {\r\n        padding: 18px 18px 20px;\r\n        color: #002A67;\r\n    }\r\n\r\n\r\n    @media (min-width: 992px) {\r\n        .box-pagos {\r\n            padding: 12px 20px 20px;\r\n        }\r\n    }\r\n\r\n\r\n\r\n\r\n\r\n.tipoIndividual {\r\n    display: inline-block;\r\n    padding: 0px 8px;\r\n    font-size: 10px;\r\n    font-weight: 700;\r\n    line-height: 20px;\r\n    color: #FFFFFF;\r\n    letter-spacing: 0.1px;\r\n    background-color: var(--ua-colours-skyblue);\r\n    border-radius: 6px 6px 6px 6px;\r\n    height: 19px;\r\n}\r\n\r\n.tipoGrupal {\r\n    display: inline-block;\r\n    padding: 0px 8px;\r\n    font-size: 10px;\r\n    font-weight: 700;\r\n    line-height: 20px;\r\n    color: #FFFFFF;\r\n    letter-spacing: 0.1px;\r\n    background-color: var(--ua-primary-alt);\r\n    border-radius: 6px 6px 6px 6px;\r\n    height: 19px;\r\n}\r\n\r\n.badge-otros {\r\n    background-color: #E2F5F5;\r\n    color: #005191;\r\n    display: inline-block;\r\n    padding: 0px 8px;\r\n    font-size: 10px;\r\n    font-weight: 700;\r\n    line-height: 20px;\r\n    letter-spacing: 0.1px;\r\n    border-radius: 6px 6px 6px 6px;\r\n    height: 19px;\r\n    margin-left: 5px;\r\n}\r\n\r\n.box-button {\r\n    display: flex;\r\n    align-items: center;\r\n    flex-wrap: wrap;\r\n}\r\n\r\n        .box-button .contenedor-upgrades {\r\n            display: flex;\r\n            gap: .25rem;\r\n            margin-left: 2%;\r\n        }\r\n\r\n        .box-button:not(.collapsed) .contenedor-upgrades {\r\n            flex-basis: 100%;\r\n            margin-left: 0;\r\n        }\r\n\r\n    .box-pasajeros .box-button {\r\n        position: relative;\r\n        padding-right: 2rem;\r\n    }\r\n\r\n        .box-pasajeros .box-button::after {\r\n            position: absolute;\r\n            right: 1rem;\r\n            top: 50%;\r\n            transform: translateY(-50%);\r\n            transition: transform .2s ease-in-out;\r\n        }\r\n\r\n        .box-pasajeros .box-button:not(.collapsed)::after {\r\n            transform: translateY(-50%) rotate(180deg);\r\n        }\r\n\r\n.box-button.collapsed .contenedor-upgrades-inline {\r\n    display: inline-flex; /* o inline-block */\r\n    gap:5px;\r\n}\r\n\r\n.box-button:not(.collapsed) .contenedor-upgrades-inline {\r\n    display: none;\r\n}\r\n\r\n.contenedor-upgrades {\r\n    margin-bottom:15px;\r\n}\r\n\r\n.form-control.is-invalid {\r\n    background-image: none !important;\r\n    background-color: #FFEBF1 !important;\r\n}\r\n\r\n.bootstrap-select.is-invalid > .btn {\r\n    background-color: #FFEBF1 !important;\r\n}\r\n"
          },
