=\"selectpicker form-control\" data-style=\"btn-bsselect\" id=\"TipoProducto\" name=\"TipoProducto\">\r\n                        <option value=\"Folleto\" =>Folleto</option>\r\n                        <option value=\"Especiales\"  selected=>Especiales</option>\r\n                        <option value=\"Precompras\" =>Precompras</option>\r\n                    </select>\r\n                </div>\r\n\r\n                <div class=\"col-12 mb-15\">\r\n                    <div class=\"legend01\">TIPO DE VIAJE</div>\r\n                    <input type=\"hidden\" id=\"Prefiltro\" name=\"Prefiltro\" value=\"\" />\r\n                    <div id=\"PrefiltroSelect\" class=\"navbar navbar-expand-sm dropdown-select\">\r\n                        <div class=\"container-fluid px-0\">\r\n                            <div class=\"navbar-collapse\">\r\n                                <div class=\"navbar-nav w-100\">\r\n                                    <div class=\"dropdown w-100\">\r\n                                        <a class=\"form-select\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">\r\n                                            <span class=\"dropdown-select-placeholder\">Seleccione un tipo de cotización</span>\r\n                                            <span class=\"dropdown-select-selected-value\"></span>\r\n                                        </a>\r\n                                        <ul class=\"dropdown-menu\" id=\"ulPrefiltros\">\r\n                                        </ul>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"col-12 mb-15\">\r\n                    <div class=\"legend01\">¿A DÓNDE VIAJAN?</div>\r\n                    <select class=\"selectpicker form-control\" data-style=\"btn-bsselect\" id=\"Destino\" name=\"Destino\">\r\n                        <option value=\"Argentina\" =>Argentina</option>\r\n                        <option value=\"Centro america/Caribe\" =>Centroam&#233;rica y Caribe (excepto Cuba*)</option>\r\n                        <option value=\"Europa\" =>Europa*</option>\r\n                        <option value=\"Internacional Mundo\" selected=>M&#250;ltiples Destinos*</option>\r\n                        <option value=\"America del norte\" =>Norteam&#233;rica</option>\r\n                        <option value=\"Asia\" =>Ocean&#237;a, Asia*, &#193;frica</option>\r\n                        <option value=\"Pa&#237;ses Lim&#237;trofes\" =>Pa&#237;ses Lim&#237;trofes</option>\r\n                        <option value=\"Am&#233;rica del Sur (salvo Vzla)\" =>Sudam&#233;rica</option>\r\n                        <option value=\"Territorio Nacional\" =>Territorio Nacional</option>\r\n                    </select>\r\n                </div>\r\n\r\n                <div class=\"col-12 mb-15\">\r\n                    <div class=\"legend01\">¿CUÁNDO VIAJAN?</div>\r\n                    <div class=\"row gx-3\">\r\n                        <div class=\"col\">\r\n                            <div class=\"form-floating\">\r\n                                <span class=\"input-icon input-icon-right icon-calendar input-group-addon\"></span>\r\n                                <input type=\"text\" class=\"form-control\" id=\"FechaInicio\" name=\"FechaInicio\" placeholder=\"Desde\" value=\"09/07/2026\" />\r\n                                <label for=\"FechaInicio\">Desde</label>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"col\">\r\n                            <div class=\"form-floating\">\r\n                                <span class=\"input-icon input-icon-right icon-calendar input-group-addon\"></span>\r\n                                <input type=\"text\" class=\"form-control\" id=\"FechaFin\" name=\"FechaFin\" placeholder=\"Hasta\" value=\"09/07/2026\" />\r\n                                <label for=\"FechaFin\">Hasta</label>\r\n                            </div>\r\n                        </div>\r\n                        <input type=\"text\" id=\"RangoFechas\" value=\"\" style=\"visibility: hidden; position: absolute; height: 45px;\" />\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"col-12 mb-15\">\r\n                    <div class=\"legend01\">¿CUÁNTOS VIAJAN?</div>\r\n                    <select class=\"selectpicker form-control\" data-style=\"btn-bsselect\" data-size=\"5\" id=\"CantidadPasajeros\" name=\"CantidadPasajeros\">\r\n                        <option value=\"1\" selected=>1</option>\r\n                        <option value=\"2\" =>2</option>\r\n                        <option value=\"3\" =>3</option>\r\n                        <option value=\"4\" =>4</option>\r\n                        <option value=\"5\" =>5</option>\r\n                        <option value=\"6\" =>6</option>\r\n                        <option value=\"7\" =>7</option>\r\n                        <option value=\"8\" =>8</option>\r\n                        <option value=\"9\" =>9</option>\r\n                        <option value=\"10\" =>10</option>\r\n                        <option value=\"11\" =>11</option>\r\n                        <option value=\"12\" =>12</option>\r\n                        <option value=\"13\" =>13</option>\r\n                        <option value=\"14\" =>14</option>\r\n                        <option value=\"15\" =>15</option>\r\n                    </select>\r\n                </div>\r\n                                <div class=\"col-12 mb-15\">\r\n                    <div class=\"legend01\">¿QUÉ EDAD TIENEN?</div>\r\n                    <div class=\"d-flex flex-wrap gap-10 recotizadorEdades\" id=\"edades\"></div>\r\n                    <input type=\"hidden\" id=\"ListaEdades\" name=\"ListaEdades\" value=\"29\" />