            "mimeType": "text/javascript",
            "text": "function FINS_Health_Policy_Coverage_List_Applet_Applet_InvokeMethod (name, inputPropSet)\r\r\n{\r\r\n   if(name == 'WriteRecord')\r\r\n   {\r\r\n\r\r\n    if (theApplication().GetProfileAttr(\"Advertencia\") != \"\")\r\r\n     {\r\r\n       theApplication().SWEAlert(\"Existe un solicitante que no está en el rango de edad permitido para el producto\");\r\r\n       theApplication().SetProfileAttr(\"Advertencia\", \"\");\r\r\n     }  \r\r\n    }  \r\r\n}\n\nfunction FINS_Health_Policy_Coverage_List_Applet_Applet (applet)\n{\n   if (applet != null)\n   {\n      this._applet = applet;\n      applet.shadow = this;\n   }\n}\n\nnew FINS_Health_Policy_Coverage_List_Applet_Applet (null);\n\nFINS_Health_Policy_Coverage_List_Applet_Applet.prototype = new window.JSSAppletShadow ();\n\nFINS_Health_Policy_Coverage_List_Applet_Applet.prototype.OnInvokeMethod = FINS_Health_Policy_Coverage_List_Applet_Applet_InvokeMethod;\ntheApplication = window.theApplication;\nTheApplication = window.theApplication;\n\n"
          },
